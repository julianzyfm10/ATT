# Copy these entries into the project's .env file and replace only the key.
# The existing .gitignore excludes .env. Never commit a real API key.
SILICONFLOW_API_KEY=sk-xxx
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
SILICONFLOW_MODEL=openai/gpt-oss-120b
# Other supported values:
# SILICONFLOW_MODEL=google/gemma-4-31B-it
# SILICONFLOW_MODEL=Qwen/Qwen3.6-35B-A3B
